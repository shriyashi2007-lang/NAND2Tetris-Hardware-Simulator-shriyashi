// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */


CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];

    PARTS:
    Inc16(in=current, out=incremented);

    Mux16(a=current, b=incremented, sel=inc, out=w1);

    Mux16(a=w1, b=in, sel=load, out=w2);

    Mux16(a=w2, b=false, sel=reset, out=w3);

    Register(in=w3, load=true, out=current);

    Or16(a=current, b=false, out=out);
}
